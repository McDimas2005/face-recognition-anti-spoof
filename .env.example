APP_ENV=development

# API
API_APP_NAME=Face Attendance API
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-this-development-secret
API_ACCESS_TOKEN_EXPIRE_MINUTES=30
API_REFRESH_TOKEN_EXPIRE_MINUTES=43200

# Docker Compose uses the `db` service hostname. For local API processes outside
# Docker, use: postgresql+psycopg://postgres:postgres@localhost:5432/attendance
API_DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/attendance
API_STORAGE_PATH=/app/data
API_RETAIN_ENROLLMENT_IMAGES=false
API_RETAIN_REVIEW_IMAGES=true

# Development bootstrap account. Change these before any shared deployment.
API_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
API_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
API_BOOTSTRAP_ADMIN_NAME=System Admin

# Comma-separated frontend origins allowed to call the API.
API_CORS_ORIGINS=http://localhost:3000,http://localhost

# Recognition thresholds
API_SIMILARITY_THRESHOLD=0.58
API_COMMIT_THRESHOLD=0.62
API_AMBIGUITY_MARGIN=0.02
API_LIVENESS_THRESHOLD=0.28
API_CONSENSUS_FRAMES=3
API_CONSENSUS_WINDOW_SECONDS=5

# Quality thresholds
API_MIN_FACE_SIZE=80
API_MAX_YAW_SCORE=0.5
API_MAX_OCCLUSION_SCORE=0.55
API_MIN_BRIGHTNESS=28.0
API_MAX_BRIGHTNESS=225.0
API_MAX_BLUR_SCORE=110.0

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
